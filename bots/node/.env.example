# ============================================================
#  Пример конфигурации Node-ботов. Скопируй в .env и заполни значения.
#  cp .env.example .env
#  Переменные те же, что у bots/python/.env.example.
# ============================================================

# --- Платформа: Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF_your_token_here

# --- Администраторы ---
# ID пользователей-админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789,987654321

# --- База данных ---
# SQLite (по умолчанию, для разработки). Формат как в Python-стеке тоже понимается:
#   sqlite+aiosqlite:///data/bot.sqlite3
DATABASE_URL=sqlite:///data/bot.sqlite3
# PostgreSQL (продакшен) — просто раскомментируй и заполни
# (postgresql+asyncpg://... из Python-стека тоже подойдёт):
# DATABASE_URL=postgres://user:password@localhost:5432/botdb

# --- Логи ---
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# --- Локализация ---
DEFAULT_LOCALE=ru

# --- Рассылки (broadcast) ---
# Сообщений в секунду (Telegram лимит ~30/сек глобально)
BROADCAST_RATE=25

# --- Webhook (platforms/telegram, опционально) ---
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token
# TELEGRAM_WEBHOOK_SECRET=

# --- Instagram (platforms/instagram) ---
# IG_ACCESS_TOKEN=
# IG_APP_SECRET=
# IG_VERIFY_TOKEN=

# --- MAX (platforms/max) ---
# MAX_BOT_TOKEN=
# MAX_WEBHOOK_SECRET=
