# ============================================================
#  Пример конфигурации. Скопируй в .env и заполни значения.
#  cp .env.example .env
# ============================================================

# --- Платформа: Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF_your_token_here

# --- Администраторы ---
# ID пользователей-админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789,987654321

# --- База данных ---
# SQLite (по умолчанию, для разработки):
DATABASE_URL=sqlite+aiosqlite:///data/bot.sqlite3
# PostgreSQL (продакшен) — просто раскомментируй и заполни:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/botdb

# --- Логи ---
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# --- Локализация ---
DEFAULT_LOCALE=ru

# --- Рассылки (broadcast) ---
# Сообщений в секунду (Telegram лимит ~30/сек глобально)
BROADCAST_RATE=25

# --- Instagram (platforms/instagram) ---
# IG_ACCESS_TOKEN=
# IG_APP_SECRET=
# IG_VERIFY_TOKEN=

# --- MAX (platforms/max) ---
# MAX_BOT_TOKEN=
