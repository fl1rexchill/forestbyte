# Скопируй в .env и заполни. Без значений сервер всё равно работает: заявки копятся в data/leads.json.
PORT=8080

# Пароль для CRM-панели (/crm/). Придумай длинный.
ADMIN_TOKEN=

# Уведомления в Telegram: токен от @BotFather и id чата (узнать: написать боту, открыть
# https://api.telegram.org/bot<TOKEN>/getUpdates и взять message.chat.id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательно: дублировать заявки в CRM (см. sites/integrations/crm/*/TUTORIAL.md)
BITRIX24_WEBHOOK=
AMOCRM_SUBDOMAIN=
AMOCRM_TOKEN=
