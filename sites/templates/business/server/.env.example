# Скопируйте файл в server/.env и заполните. Секреты храните только здесь, не в config.js.
# Без значений сервер работает: заявки сохраняются в server/data/leads.json.
PORT=8090

# Пароль для CRM-панели (/crm/). Длинная случайная строка. Пусто — CRM-панель закрыта.
ADMIN_TOKEN=

# Уведомления в Telegram. Работают только для сайтов с meta.mode: 'production' в config.js.
# Токен — от @BotFather. ID чата: напишите боту, откройте
# https://api.telegram.org/bot<ТОКЕН>/getUpdates и возьмите message.chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# За reverse proxy (nginx) поставьте 1, чтобы лимит заявок считался по реальному IP клиента.
# Без прокси оставьте пустым: иначе клиент подменит заголовок X-Forwarded-For.
TRUST_PROXY=
# Лимит заявок с одного IP за 10 минут (по умолчанию 8).
RATE_LIMIT=

# Необязательно: копия заявки в CRM (см. sites/integrations/crm/*/TUTORIAL.md).
BITRIX24_WEBHOOK=
AMOCRM_SUBDOMAIN=
AMOCRM_TOKEN=
